OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=una-chat-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
# Lab 8: copiar a .env para el login local. No subir .env a Git.
# Sin AUTH0_DOMAIN y AUTH0_CLIENT_ID el chat queda abierto (asi corren las pruebas).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
APP_BASE_URL=http://localhost:3000

# Conexion Postgres del rol una_chat_backend. TLS obligatorio.
# Host directo (IPv6): postgresql://una_chat_backend:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full
# Session pooler (IPv4): postgresql://una_chat_backend.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
VAULT_DATABASE_URL=

# No definir AUTH0_CLIENT_SECRET. El servidor lee una_chat_auth0_client_secret desde Supabase Vault al arrancar.
